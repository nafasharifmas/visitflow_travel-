{
  "info": {
    "name": "Visit Flow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"newuser\",\n  \"name\": \"New User\",\n  \"email\": \"new@example.com\",\n  \"password\": \"Secret123\",\n  \"password_confirmation\": \"Secret123\"\n}"
        }
      }
    },
    {
      "name": "Login (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"admin@visitflow.local\",\n  \"password\": \"Admin@12345\"\n}"
        }
      },
      "listen": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('admin_token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login (user)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"user\",\n  \"password\": \"User@12345\"\n}"
        }
      },
      "listen": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('user_token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{base_url}}/logout",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
